##############################################################
# Reativador — variáveis de ambiente
# Copie e cole na aba "Environment" do EasyPanel, preenchendo.
##############################################################

# ---------- OBRIGATÓRIAS ----------

# Endereço público do app (sem barra no fim). É usado no OAuth do Bling.
APP_URL=https://reativador.seudominio.com.br

# Senha do painel (Basic Auth: usuário vazio, só a senha).
# Se ficar vazia, o painel fica ABERTO — não faça isso.
ADMIN_SENHA=troque-esta-senha

# Evolution API (o WhatsApp)
EVOLUTION_URL=https://evolution.seudominio.com.br
EVOLUTION_APIKEY=sua-api-key
EVOLUTION_INSTANCE=nome-da-instancia

# Seu WhatsApp: recebe o resumo de cada rodada e os avisos de erro
ADMIN_WHATSAPP=5551999999999


# ---------- BLING (só se você for usar a reativação automática) ----------
# Crie o app em https://developer.bling.com.br
# URL de redirecionamento: {APP_URL}/auth/bling/callback
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=


# ---------- OPCIONAIS (tudo tem padrão) ----------

# Fuso usado nos horários das campanhas
TZ=America/Sao_Paulo

# Onde os dados ficam. No EasyPanel, monte um VOLUME neste caminho.
DATA_DIR=/data

# De quanto em quanto tempo o app olha as campanhas.
# Não é a frequência de envio: cada campanha tem seu próprio intervalo.
CRON_TICK=*/5 * * * *

# --- Proteção do número (valores iniciais; depois se ajusta no painel) ---
LIMITE_DIARIO=150        # máximo de mensagens por dia, no número inteiro
PAUSA_MIN_SEG=35         # pausa mínima entre uma mensagem e a próxima
PAUSA_MAX_SEG=95         # pausa máxima (o app sorteia entre mínima e máxima)
TETO_ENVIOS=12           # máximo por rodada, padrão das campanhas novas

# --- Reativação do Bling ---
COOLDOWN_DIAS=30         # não manda pro mesmo cliente antes disso
HORARIO_INICIO=9         # janela padrão das campanhas novas
HORARIO_FIM=19
BLING_MAX_PAGINAS=5      # 5 x 100 = até 500 pedidos por janela
DIAS_SEM_TELEFONE=15     # contato sem telefone no Bling: espera antes de tentar de novo

# --- Outros ---
MAX_UPLOAD_MB=8          # tamanho máximo da planilha
LOG_MAX=300              # quantos eventos ficam guardados no log
WEBHOOK_TOKEN=           # se preencher, o webhook exige ?token=esse-valor
EVOLUTION_TIMEOUT_MS=25000
